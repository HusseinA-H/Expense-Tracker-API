# Copy to .env.staging or .env.production and replace all secrets before deploy.
# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=staging
APP_VERSION=1.0.0-rc.1
PROJECT_NAME="Expense Tracker API"
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_CHAR_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Security
CORS_ORIGINS=https://staging.example.com
OPENAPI_ENABLED=false
TRUSTED_HOSTS=staging.example.com,localhost,nginx,api

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=expense_user
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_NAME=expense_tracker

DB_READ_HOST=postgres
DB_READ_PORT=5432
DB_READ_USER=expense_user
DB_READ_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_READ_NAME=expense_tracker

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# Observability
GRAFANA_PASSWORD=REPLACE_WITH_STRONG_GRAFANA_PASSWORD
OTEL_EXPORTER_ENDPOINT=http://jaeger:4317

# SMTP (use real provider in staging/production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=REPLACE
SMTP_PASSWORD=REPLACE
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="Expense Tracker"
