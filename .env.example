# General
ENVIRONMENT=development
APP_VERSION=1.0.0-rc.1
PROJECT_NAME="Expense Tracker API"
API_V1_STR="/api/v1"
API_V2_STR="/api/v2"
SECRET_KEY=generate_a_secure_random_key_here_for_jwt_signing
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# Security (development defaults)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
OPENAPI_ENABLED=true
TRUSTED_HOSTS=localhost,127.0.0.1,api

# Database (Write / Primary)
DB_HOST=postgres
DB_PORT=5432
DB_USER=expense_user
DB_PASSWORD=expense_secure_pass_123
DB_NAME=expense_tracker

# Database (Read Replica - defaults to DB_HOST if not set)
DB_READ_HOST=postgres
DB_READ_PORT=5432
DB_READ_USER=expense_user
DB_READ_PASSWORD=expense_secure_pass_123
DB_READ_NAME=expense_tracker

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_123

# Grafana & Observability
GRAFANA_PASSWORD=grafana_secure_pass_123
OTEL_EXPORTER_ENDPOINT=http://jaeger:4317

# Email (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=dummy_user
SMTP_PASSWORD=dummy_pass
SMTP_FROM_EMAIL=noreply@expensetracker.com
SMTP_FROM_NAME="Expense Tracker API"
